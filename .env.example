# Copy to .env and fill in.
#
# NOTE: the mail settings below are imported ONCE, the first time the app runs (into
# data/mail_providers.json). After that, manage Resend keys and SMTP on the Settings page.
# To re-import from .env, delete data/mail_providers.json and restart.

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be an address on a domain you verified in Resend, e.g. certificates@yourdomain.com
FROM_EMAIL=certificates@yourdomain.com
# Extra Resend keys to switch to when one hits its limit (label=key, comma separated).
# A label's sender is FROM_EMAIL_<LABEL>, falling back to FROM_EMAIL.
# RESEND_API_KEYS=work=re_aaaa,personal=re_bbbb
# FROM_EMAIL_WORK=certificates@work.com
# FROM_EMAIL_PERSONAL=hello@personal.com

# --- SMTP (optional; used as the fallback after Resend) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | ssl | none
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=you@gmail.com # defaults to FROM_EMAIL, then SMTP_USERNAME

# --- General ---
# Seconds between emails (Resend allows ~2 requests/second by default)
SEND_DELAY_SECONDS=0.6
# Where projects and mail settings are stored (default: ./data)
# DATA_DIR=
