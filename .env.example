# Copy to .env and fill in.
#
# NOTE: the mail settings below are imported ONCE, the first time the app runs (into
# data/mail_providers.json). After that, manage SMTP on the Settings page.
# To re-import from .env, delete data/mail_providers.json and restart.

# --- SMTP (all mail is sent over SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl             # ssl | starttls | none
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com       # defaults to SMTP_USER
SMTP_FROM_NAME=Your Organisation

# --- General ---
# Seconds between emails
SEND_DELAY_SECONDS=0.6
# Where projects and mail settings are stored (default: ./data)
# DATA_DIR=
